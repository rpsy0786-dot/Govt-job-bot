# Telegram Bot Configuration
# Get TELEGRAM_BOT_TOKEN from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_father_token_here

# Your personal Telegram user ID, or a channel/group chat ID (e.g. -100123456789)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Database & Scheduler Config
DATABASE_PATH=jobs.db
SEND_TIME=09:00

# Job Matching Preferences
MAX_EXPERIENCE=8
